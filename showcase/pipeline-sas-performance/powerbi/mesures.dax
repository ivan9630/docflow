-- Créer une mesure distincte pour chacune de ces définitions dans Power BI.
Impressions = SUM(fact_campagnes[impressions])
Clics = SUM(fact_campagnes[clics])
Contacts = SUM(fact_campagnes[contacts])
Rendez-vous = SUM(fact_campagnes[rdv])
Depenses = SUM(fact_campagnes[cout_eur])
CTR = DIVIDE([Clics], [Impressions], 0)
Taux de contact = DIVIDE([Contacts], [Clics], 0)
Taux RDV par contact = DIVIDE([Rendez-vous], [Contacts], 0)
Cout par rendez-vous = DIVIDE([Depenses], [Rendez-vous], BLANK())
RDV pour 1000 impressions = 1000 * DIVIDE([Rendez-vous], [Impressions], 0)
Part des RDV nationaux = DIVIDE([Rendez-vous], CALCULATE([Rendez-vous], ALL(dim_region)), 0)
Ecart CTR vs national = [CTR] - CALCULATE([CTR], REMOVEFILTERS(dim_region))
Impact descriptif DiD =
VAR EA = CALCULATE([RDV pour 1000 impressions], REMOVEFILTERS(fact_campagnes[expose], fact_campagnes[post]), fact_campagnes[expose]=1, fact_campagnes[post]=1)
VAR EV = CALCULATE([RDV pour 1000 impressions], REMOVEFILTERS(fact_campagnes[expose], fact_campagnes[post]), fact_campagnes[expose]=1, fact_campagnes[post]=0)
VAR TA = CALCULATE([RDV pour 1000 impressions], REMOVEFILTERS(fact_campagnes[expose], fact_campagnes[post]), fact_campagnes[expose]=0, fact_campagnes[post]=1)
VAR TV = CALCULATE([RDV pour 1000 impressions], REMOVEFILTERS(fact_campagnes[expose], fact_campagnes[post]), fact_campagnes[expose]=0, fact_campagnes[post]=0)
RETURN (EA - EV) - (TA - TV)
